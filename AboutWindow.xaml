<Window x:Class="NazwaProjektu.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="220"
        Width="400"
        Background="Black">

    <StackPanel Margin="20">

        <TextBlock Text="Skyrim Quest Journal!!!!"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="White"/>

        <TextBlock Text="Simple WPF for Skyrim quests yippie yay"
                   TextAlignment="Center"
                   Margin="0,20"
                   Foreground="White"/>

        <TextBlock Text="Made by Roman!!!! i like skyrim"
                   FontSize="24"
                   TextAlignment="Center"
                   Margin="0,-5,0,20"
                   Foreground="White"/>

        <Button Content="Close"
                Width="80"
                HorizontalAlignment="Center"
                Click="Close_Click"
                Foreground="White"
                Background="#333333"
                BorderBrush="White"/>

    </StackPanel>
    
</Window>